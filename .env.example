# Local overrides for docker-compose.prod.yaml (Docker Compose reads this file
# for variable interpolation in the project root). Copy to `.env` and fill in
# values as needed. Do not commit `.env` (it may contain secrets).

# Headless Telegram group status reports for the consumer service.
# Leave disabled or unset if you do not use the Telegram bot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INTERVAL_MINUTES=30
TELEGRAM_TIMEZONE=Asia/Jakarta
