// Light relay input polarity (D6 / GPIO12).
// Most opto-isolated modules are active-LOW: LOW = relay closed = lamp ON.
// If the lamp stays ON after a light-off command, or is ON at boot, your module
// is active-HIGH: set this to false.
#define LIGHT_RELAY_ACTIVE_LOW true

