# MQTT Broker Configuration
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=iot_user
MQTT_PASS=iot_password

# mqtt for TCP; mqtts for TLS (standard CA verification remains enabled)
MQTT_PROTOCOL=mqtt
# Optional; omit to generate a unique ID for every consumer process.
# MQTT_CLIENT_ID=consumer-room-main

# Web Server Configuration
HOST=0.0.0.0
PORT=8000

# Timeouts in seconds. A missing device ACK returns ack: null, not a success ACK.
COMMAND_ACK_TIMEOUT=6
COMMAND_PUBLISH_TIMEOUT=2
STALE_AFTER_SECONDS=30

# Same-origin by default. Optional comma-separated origins for external API clients.
# Set * only when unrestricted cross-origin API access is intentional.
CORS_ORIGIN=

# Existing Python model, accessed by Express on the same dashboard origin.
ANALYTICS_URL=http://127.0.0.1:8001
